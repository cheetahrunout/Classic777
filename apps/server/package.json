{
  "name": "@classic777/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs --external:fastify --external:@fastify/static --external:zod",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/static": "8.0.4",
    "fastify": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@classic777/shared": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.24.2"
  }
}
